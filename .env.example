# Public SDK configuration only. Never put service-account or secret API keys here.
# Test is the default. Native manifests also use Google's demo application IDs.
VITE_ADS_MODE=test
VITE_ADMOB_ANDROID_INTERSTITIAL=
VITE_ADMOB_IOS_INTERSTITIAL=
# RevenueCat public platform SDK keys, with the non-consumable product attached
# to the remove_ads entitlement. Leave blank to show an unavailable purchase button.
VITE_REVENUECAT_ANDROID_KEY=
VITE_REVENUECAT_IOS_KEY=
VITE_REMOVE_ADS_PRODUCT_ID=quoridor_remove_ads
